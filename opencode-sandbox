#!/usr/bin/env bash
# opencode-sandbox is a Go program since 0.5.0. This script keeps a git clone
# working as before (symlink it into your PATH): it builds the program from
# this clone when the sources changed, then runs it. Release binaries and
# `go install` don't need it; see README.md.
set -euo pipefail
here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
bin="$here/.bin/opencode-sandbox"
if [[ ! -x "$bin" || -n "$(find "$here" \( -path "$here/.bin" -o -path "$here/.git" \) -prune -o \
      \( -name '*.go' -o -name go.mod -o -name go.sum -o -name Dockerfile -o -name entrypoint.sh -o -name ssh_config \) \
      -newer "$bin" -print -quit)" ]]; then
  command -v go >/dev/null || {
    echo "opencode-sandbox: this clone needs Go (https://go.dev/dl/) to build itself;" \
      "or install a release binary instead (see README.md)" >&2
    exit 1
  }
  (cd "$here" && go build -trimpath -o "$bin" ./cmd/opencode-sandbox) >&2
fi
# Disposable keys and known_hosts of 0.4 and earlier live in this clone.
export OPENCODE_SANDBOX_LEGACY_DIR="$here"
exec "$bin" "$@"
