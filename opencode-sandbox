#!/usr/bin/env bash
# opencode in hardened sandboxes (containers). Each sandbox may use at most ONE
# SSH key, chosen when it is created:
#   - an existing key pair from ~/.ssh
#   - a new disposable key, kept in ./keys (never in ~/.ssh) and deleted with
#     the sandbox; its public part is shown so you can authorize it on servers
#   - none: no SSH access at all
# A private key never enters a sandbox: an open sandbox gets its own host
# ssh-agent holding only its key, and only that agent's socket is mounted in.
# The agent is stopped when the sandbox closes.
#
# Files: DIR is COPIED into a sandbox when it is created, never mounted, so
# nothing the agent writes reaches DIR. Each sandbox has its own /workspace and
# home (opencode sessions). Exiting opencode stops the sandbox and every process
# in it; its files stay until you --rm it.
#
# Usage: opencode-sandbox --help
set -euo pipefail

HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"
VERSION="0.1.0"  # bump with each release, see CHANGELOG.md
# Tagged with the launcher's version, so after an update the next run builds
# the matching image by itself.
IMAGE="opencode-sandbox:$VERSION"
NETWORK="opencode-sandbox-net"
PREFIX="opencode-sandbox-"
LABEL="opencode-sandbox.name"
# Docker's default (ctrl-p,ctrl-q) would swallow opencode's ctrl+p palette.
DETACH_KEYS="ctrl-],ctrl-]"
KEYS_DIR="$HERE/keys"
# Your opencode config; sandboxes get filtered copies of it.
CONFIG="${OPENCODE_SANDBOX_CONFIG:-$HOME/.config/opencode/opencode.json}"
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}/opencode-sandbox"
# Hosts (e.g. a jump host) whose keys are copied from your ~/.ssh/known_hosts
# into ./known_hosts, which every sandbox trusts, so the first hop is verified.
# Read when ./known_hosts is created; delete that file to re-seed.
read -ra SEED_HOSTS <<<"${OPENCODE_SANDBOX_SEED_HOSTS:-}"

# Checked here, not inside $(...), where stdout is always a pipe.
TTY=-i; [[ -t 0 && -t 1 ]] && TTY=-it

die() { echo "opencode-sandbox: $*" >&2; exit 1; }
note() { echo "opencode-sandbox: $*" >&2; }

usage() {
  cat <<EOF
Usage: opencode-sandbox [-w DIR] [-n NAME] [-k KEY] [-p PROVIDER] [-- ARGS...]
       opencode-sandbox COMMAND

Run opencode in a hardened sandbox (a container). Without a command, this
creates a NEW sandbox every time, with a copy of DIR, and opens opencode in it.

Options for a new sandbox:
  -w DIR          folder to copy into the sandbox's /workspace (default: the
                  current folder). It is copied, never mounted, so nothing the
                  agent does reaches DIR. Your home folder, ~/.ssh and this
                  setup's own folder are refused.
  -n NAME         sandbox name (default: the folder's name plus a random suffix)
  -k KEY          the one SSH key the sandbox may use (asked if omitted):
                    NAME  a key pair from ~/.ssh, e.g. id_ed25519
                    new   a new disposable key, deleted with the sandbox; its
                          public part is shown so you can authorize it on
                          servers. Kept in:
                          $KEYS_DIR
                    none  no SSH access
  -p PROVIDER     the opencode provider(s) the sandbox may use, from your
                  opencode config; several as a,b (asked if omitted, or picked
                  automatically when you have only one). The sandbox gets a
                  config with only those providers and their API keys;
                  opencode's built-in providers are switched off.
  -- ARGS         pass the remaining arguments to opencode

Commands:
  --list          list sandboxes
  --resume [NAME] reopen a sandbox and continue its last opencode session
                  (shows a numbered list to pick from if NAME is omitted)
  --pubkey NAME   print the public key a sandbox uses
  --shell NAME    open bash inside a sandbox that is currently open
  --rm NAME...    delete sandboxes, their files and their disposable keys
  --rm --all      delete every sandbox (asks first)
  --status        show the ssh-agents of open sandboxes and their keys
  --stop-agent    stop all sandbox ssh-agents (cuts SSH for open sandboxes)
  --build [ARGS]  rebuild the image (extra ARGS go to docker build);
                  existing sandboxes keep the image they were created with
  -V, --version   show the opencode-sandbox and opencode versions
  -h, --help      show this help

Environment:
  OPENCODE_SANDBOX_CONFIG      opencode config to take providers from
                               (default: ~/.config/opencode/opencode.json)
  OPENCODE_SANDBOX_SEED_HOSTS  hosts (e.g. a jump host) whose keys are copied
                               from your ~/.ssh/known_hosts into sandboxes so
                               the first hop is verified; space-separated,
                               e.g. "[jump.example.com]:2222 bastion.lan"

Inside a sandbox:
  Quitting opencode or closing the terminal stops the sandbox and unloads its
  key. Press ctrl-] ctrl-] to detach and leave it running; --resume reattaches.
  A private key never enters a sandbox: it can use its one key through a
  dedicated ssh-agent, but cannot read or copy it.

Examples:
  opencode-sandbox -w ./workdir                    new sandbox, pick a key
  opencode-sandbox -w ./workdir -n prod -k id_ed25519 -p my-provider
  opencode-sandbox -w ./workdir -k new             with a disposable key
  opencode-sandbox --resume prod                   continue where you left off
EOF
}

# --- sandbox lookups ---------------------------------------------------------

exists() { docker container inspect "$PREFIX$1" >/dev/null 2>&1; }
state()  { docker container inspect -f '{{.State.Status}}' "$PREFIX$1" 2>/dev/null; }
label()  { docker container inspect -f "{{index .Config.Labels \"opencode-sandbox.$2\"}}" "$PREFIX$1"; }
names()  { docker ps -a --filter "label=$LABEL" --format "{{.Label \"$LABEL\"}}"; }

# --- per-sandbox ssh-agents --------------------------------------------------

agent_dir()   { printf '%s/agents/%s\n' "$RUNDIR" "$1"; }  # only <dir>/sock is mounted
on_sock()     { SSH_AUTH_SOCK="$1" "${@:2}"; }
fingerprint() { ssh-keygen -lf "$1" | awk '{print $2}'; }

ensure_agent() {  # $1 sandbox, $2 private key: (re)start an agent holding only that key
  local dir sock want have rc=0
  dir="$(agent_dir "$1")"; sock="$dir/sock/ssh-agent.sock"
  [[ -r "$2" && -r "$2.pub" ]] || die "missing key $2 (or its .pub)"
  want="$(fingerprint "$2.pub")"
  install -d -m 700 "$RUNDIR" "$RUNDIR/agents" "$dir" "$dir/sock"
  printf '%s\n' "$2" >"$dir/key"
  touch "$dir"  # marks it fresh for gc_agents

  on_sock "$sock" ssh-add -l >/dev/null 2>&1 || rc=$?
  if (( rc == 2 )); then  # nothing listening: start a fresh agent
    rm -f "$sock"
    # -P: refuse to load any PKCS#11/FIDO provider library on request.
    ssh-agent -s -a "$sock" -P /nonexistent \
      | sed -n 's/^SSH_AGENT_PID=\([0-9]*\);.*/\1/p' >"$dir/ssh-agent.pid"
  fi

  have="$(on_sock "$sock" ssh-add -l 2>/dev/null | awk '{print $2}' || true)"
  if [[ "$have" != "$want" ]]; then
    on_sock "$sock" ssh-add -D >/dev/null 2>&1 || true
    if [[ -t 0 ]]; then
      on_sock "$sock" ssh-add -q "$2"  # may ask for the key's passphrase
    else
      on_sock "$sock" ssh-add -q "$2" </dev/null
    fi || die "could not load $2"
    have="$(on_sock "$sock" ssh-add -l 2>/dev/null | awk '{print $2}' || true)"
    [[ "$have" == "$want" ]] || die "agent for '$1' holds unexpected identities; run: $0 --stop-agent"
  fi
}

stop_agent() {  # $1 agent dir
  [[ -s "$1/ssh-agent.pid" ]] && kill "$(cat "$1/ssh-agent.pid")" 2>/dev/null || true
  rm -rf -- "$1"
}

close_agent() {  # $1 sandbox: stop its agent unless the sandbox is (still) open
  [[ "$(state "$1")" == running ]] || stop_agent "$(agent_dir "$1")"
}

# Agents whose sandbox is no longer open serve nobody (e.g. the launcher was
# killed outright). Fresh ones are skipped: their sandbox may still be starting.
gc_agents() {
  local d
  [[ -d "$RUNDIR/agents" ]] || return 0
  while IFS= read -r d; do close_agent "${d##*/}"; done \
    < <(find "$RUNDIR/agents" -mindepth 1 -maxdepth 1 -type d -mmin +1)
}

# --- key choice --------------------------------------------------------------

home_keys() {  # key pairs in ~/.ssh
  local pub
  for pub in "$HOME"/.ssh/*.pub; do
    [[ -f "$pub" && -f "${pub%.pub}" ]] && printf '%s\n' "${pub%.pub}"
  done
  return 0
}

# Sets KEY_KIND (home|disposable|none), KEY_PATH and KEY_NAME (file name in the sandbox).
choose_key() {
  local want="$1" n i total; local -a keys
  mapfile -t keys < <(home_keys)
  total=$(( ${#keys[@]} + 2 ))
  if [[ -z "$want" ]]; then
    [[ -t 0 ]] || die "no terminal to ask which SSH key to use; pass -k NAME, -k new or -k none"
    {
      echo "Which SSH key may sandbox '$SB_NAME' use?"
      for i in "${!keys[@]}"; do
        printf '  %d) %-16s %s\n' $((i + 1)) "${keys[i]##*/}" \
          "$(ssh-keygen -lf "${keys[i]}.pub" | awk '{c=""; for (j=3; j<NF; j++) c=c" "$j; printf "%-9s %s%s", $NF, $2, c}')"
      done
      printf '  %d) %-16s %s\n' $((total - 1)) "new disposable" "a fresh key for this sandbox only, deleted with it"
      printf '  %d) %-16s %s\n' "$total" "none" "no SSH access"
    } >&2
    while :; do
      read -rp "Choice [1-$total]: " n || die "no choice made"
      [[ "$n" =~ ^[1-9][0-9]*$ ]] && (( n <= total )) && break
    done
    if (( n <= ${#keys[@]} )); then want="${keys[n-1]}"
    elif (( n == total - 1 )); then want=new
    else want=none; fi
  fi
  case "$want" in
    none) KEY_KIND=none KEY_PATH=none KEY_NAME="" ;;
    new)  KEY_KIND=disposable KEY_PATH="$KEYS_DIR/$SB_NAME" KEY_NAME=sandbox_key ;;
    *)    [[ "$want" == */* ]] || want="$HOME/.ssh/$want"
          [[ -f "$want" && -f "$want.pub" ]] || die "no key pair at $want (+ .pub)"
          KEY_KIND=home KEY_PATH="$(readlink -f "$want")" KEY_NAME="${want##*/}" ;;
  esac
  [[ "$KEY_NAME" =~ ^[A-Za-z0-9._@+-]*$ && "$KEY_PATH" != *,* ]] || die "unsupported key path: $KEY_PATH"
}

new_disposable_key() {
  install -d -m 700 "$KEYS_DIR"
  [[ ! -e "$KEY_PATH" && ! -e "$KEY_PATH.pub" ]] \
    || die "a disposable key '$SB_NAME' already exists in $KEYS_DIR (left from a deleted sandbox?); delete it first"
  ssh-keygen -q -t ed25519 -N '' -C "opencode-sandbox-$SB_NAME-$(date +%F)" -f "$KEY_PATH" </dev/null
}

discard_key() {  # delete a disposable key pair; never touches anything outside ./keys
  [[ "$1" == "$KEYS_DIR/"* ]] || return 0
  rm -f -- "$1" "$1.pub"
}

show_new_key() {
  {
    echo
    echo "Sandbox '$SB_NAME' has a new disposable SSH key. The private part stays on this"
    echo "machine in $KEYS_DIR (never inside the sandbox) and is deleted with the sandbox."
    echo "Authorize it where the sandbox may log in, e.g. in ~/.ssh/authorized_keys on the server:"
    echo
    cat "$KEY_PATH.pub"
    echo
    echo "Print it again any time with: opencode-sandbox --pubkey $SB_NAME"
  } >&2
  if [[ -t 0 ]]; then read -rp "Press Enter to open the sandbox... " _ || true; fi
}

# --- opencode providers ------------------------------------------------------

# jq program: keep only the chosen providers ($keep), switch off opencode's
# built-in ones (its free "opencode" provider would otherwise be offered too),
# and drop model settings that point at a provider the sandbox doesn't get.
CONFIG_FILTER='
  def ok: (split("/")[0]) as $p | $keep | index($p) != null;
  def prune: if (.model? | type) == "string" and (.model | ok | not) then del(.model) else . end;
  .provider = ((.provider // {}) | with_entries(select(.key as $k | $keep | index($k) != null)))
  | .enabled_providers = $keep
  | prune
  | if (.small_model? | type) == "string" and (.small_model | ok | not) then del(.small_model) else . end
  | if (.agent? | type) == "object" then .agent |= map_values(if type == "object" then prune else . end) else . end
  | if (.mode? | type) == "object" then .mode |= map_values(if type == "object" then prune else . end) else . end
  | if has("model") then . else
      (.provider[$keep[0]].models // {} | keys_unsorted[0]) as $m
      | if $m then .model = "\($keep[0])/\($m)" else . end
    end'

provider_ids() { jq -r '.provider // {} | keys_unsorted[]' "$CONFIG"; }
config_file() { printf '%s/configs/%s.json\n' "$RUNDIR" "$1"; }

# Sets PROVIDERS: comma-separated provider ids from your opencode config.
choose_providers() {
  local want="$1" n i p total; local -a ids picked nums
  jq -e . "$CONFIG" >/dev/null 2>&1 || die "cannot parse $CONFIG as JSON"
  mapfile -t ids < <(provider_ids)
  total=${#ids[@]}
  (( total )) || die "no providers are configured in $CONFIG"
  if [[ -z "$want" ]]; then
    if (( total == 1 )); then
      want="${ids[0]}"
      note "using the only provider in your opencode config: $want"
    else
      [[ -t 0 ]] || die "no terminal to ask which opencode provider to use; pass -p NAME"
      {
        echo "Which opencode provider(s) may sandbox '$SB_NAME' use?"
        i=0
        while IFS=$'\t' read -r p n; do
          i=$((i + 1)); printf '  %d) %-24s %s\n' "$i" "$p" "$n"
        done < <(jq -r '.provider | to_entries[] | [.key, "\(.value.name // "") (\(.value.models // {} | length | if . == 1 then "1 model" else "\(.) models" end))"] | @tsv' "$CONFIG")
      } >&2
      while :; do
        read -rp "Choice [1-$total; several like 1,3]: " n || die "no choice made"
        n="${n// /}"; picked=()
        IFS=, read -ra nums <<<"$n"
        for i in "${nums[@]}"; do
          [[ "$i" =~ ^[1-9][0-9]*$ ]] && (( i <= total )) || { picked=(); break; }
          picked+=("${ids[i-1]}")
        done
        (( ${#picked[@]} )) && break
      done
      want="$(IFS=,; echo "${picked[*]}")"
    fi
  fi
  IFS=, read -ra picked <<<"$want"
  for p in "${picked[@]}"; do
    printf '%s\n' "${ids[@]}" | grep -qxF -- "$p" \
      || die "no provider '$p' in $CONFIG (have: $(IFS=,; echo "${ids[*]}"))"
  done
  PROVIDERS="$want"
}

# (Re)write a sandbox's private opencode config: a filtered copy of yours. It
# lives in $RUNDIR (RAM, user-only) and is regenerated on every start, so
# changes to your config (e.g. a rotated API key) reach the sandbox.
write_config() {  # $1 sandbox, $2 comma-separated providers
  local out keep p; local -a ids want have=()
  mapfile -t ids < <(provider_ids)
  IFS=, read -ra want <<<"$2"
  for p in "${want[@]}"; do
    if printf '%s\n' "${ids[@]}" | grep -qxF -- "$p"; then have+=("$p")
    else note "provider '$p' is no longer in $CONFIG; sandbox '$1' won't get it"; fi
  done
  (( ${#have[@]} )) || die "none of sandbox '$1''s providers ($2) are in $CONFIG any more"
  keep="$(printf '%s\n' "${have[@]}" | jq -R . | jq -cs .)"
  out="$(config_file "$1")"
  install -d -m 700 "$RUNDIR" "$RUNDIR/configs"
  ( umask 077; jq --argjson keep "$keep" "$CONFIG_FILTER" "$CONFIG" >"$out.tmp" ) \
    || die "could not filter $CONFIG"
  mv -f "$out.tmp" "$out"
}

# --- host-side setup ---------------------------------------------------------

seed_known_hosts() {
  local out="$HERE/known_hosts" h
  [[ -f "$out" ]] && return
  for h in "${SEED_HOSTS[@]}"; do
    ssh-keygen -F "$h" -f "$HOME/.ssh/known_hosts" 2>/dev/null | grep -v '^#' || true
  done >"$out"
  chmod 644 "$out"
}

build_image() {
  docker build -t "$IMAGE" --build-arg UID="$(id -u)" --build-arg GID="$(id -g)" \
    --build-arg OPENCODE_SANDBOX_VERSION="$VERSION" "$@" "$HERE"
}

# Everything a sandbox needs on the host before it is created or resumed.
prepare() {
  [[ -r "$CONFIG" ]] || die "missing $CONFIG"
  seed_known_hosts
  docker image inspect "$IMAGE" >/dev/null 2>&1 || build_image
  # Sandboxes share this network but cannot talk to each other (icc off).
  docker network inspect "$NETWORK" >/dev/null 2>&1 \
    || docker network create -o com.docker.network.bridge.enable_icc=false "$NETWORK" >/dev/null
  gc_agents
}

resolve_workspace() {
  local dir home p
  dir="$(readlink -f "${1:-$PWD}")" || die "bad directory: ${1:-$PWD}"
  [[ -d "$dir" ]] || die "not a directory: $dir"
  home="$(readlink -f "$HOME")"
  # Never copy your home dir (or anything containing it) in: ~/.ssh is in there.
  [[ "$home/" == "${dir%/}/"* ]] && die "refusing to copy $dir: it contains your home directory"
  for p in .ssh .gnupg .config .local .aws .kube .docker; do
    [[ "$dir/" == "$home/$p/"* ]] && die "refusing to copy $dir: it is inside ~/$p"
  done
  # Nor this launcher's own files (which include the disposable keys).
  [[ "$HERE/" == "${dir%/}/"* || "$dir/" == "$HERE/"* ]] \
    && die "refusing to copy $dir: it contains the opencode-sandbox setup ($HERE)"
  printf '%s\n' "$dir"
}

# --- sandboxes ---------------------------------------------------------------

default_name() {
  local base="${1##*/}" name
  base="${base//[^A-Za-z0-9_.-]/-}"
  [[ "$base" =~ ^[A-Za-z0-9] ]] || base="sb$base"
  while :; do
    name="$base-$(od -An -N2 -tx1 /dev/urandom | tr -d ' \n')"
    exists "$name" || break
  done
  printf '%s\n' "$name"
}

create_sandbox() {
  local name="$1" cname="$PREFIX$1"; shift
  local -a ssh=()
  if [[ "$KEY_KIND" != none ]]; then
    ssh=(-e SSH_AUTH_SOCK=/run/ssh-agent/ssh-agent.sock
         --mount "type=bind,src=$(agent_dir "$name")/sock,dst=/run/ssh-agent,readonly"
         --mount "type=bind,src=$KEY_PATH.pub,dst=/home/agent/.ssh/$KEY_NAME,readonly"
         --mount "type=bind,src=$KEY_PATH.pub,dst=/home/agent/.ssh/$KEY_NAME.pub,readonly")
  fi

  # Hardening: immutable rootfs, no capabilities, no privilege escalation, and
  # only the variables below. Your host SSH_AUTH_SOCK is NOT passed through.
  # /tmp needs exec: opencode's TUI unpacks a native .so there and loads it.
  docker create "$TTY" --name "$cname" \
    --label "$LABEL=$name" --label "opencode-sandbox.source=$WORKSPACE" \
    --label "opencode-sandbox.keykind=$KEY_KIND" --label "opencode-sandbox.key=$KEY_PATH" \
    --init --read-only --cap-drop ALL --security-opt no-new-privileges:true \
    --pids-limit 1024 --tmpfs /tmp:exec,size=1g,mode=1777 \
    --network "$NETWORK" \
    -e TERM="${TERM:-xterm-256color}" -e COLORTERM="${COLORTERM:-}" \
    --mount type=volume,dst=/home/agent \
    --mount type=volume,dst=/workspace \
    --label "opencode-sandbox.providers=$PROVIDERS" --label "opencode-sandbox.version=$VERSION" \
    --mount "type=bind,src=$(config_file "$name"),dst=/home/agent/.config/opencode/opencode.json,readonly" \
    --mount "type=bind,src=$HERE/known_hosts,dst=/etc/ssh/ssh_known_hosts,readonly" \
    "${ssh[@]}" \
    "$IMAGE" opencode "$@" >/dev/null

  # Copy (never mount) the workspace in; -a keeps your uid so the agent can edit it.
  docker cp -a -q "$WORKSPACE/." "$cname:/workspace" \
    || { docker rm -v "$cname" >/dev/null; die "could not copy $WORKSPACE into the sandbox"; }
}

open_sandbox() {
  local rc=0 hangup="" pid
  # Closing the terminal stops the sandbox; only ctrl-] ctrl-] leaves it running.
  # The docker client runs in the background because bash defers traps while a
  # foreground command runs; `wait` returns as soon as one of these arrives.
  trap 'hangup=1' HUP TERM
  if [[ "$(state "$1")" == running ]]; then
    note "sandbox '$1' is already open elsewhere; attaching to it (detach: ctrl-] ctrl-])"
    docker attach --detach-keys "$DETACH_KEYS" "$PREFIX$1" <&0 &
  else
    note "opening sandbox '$1'"
    docker start -a -i --detach-keys "$DETACH_KEYS" "$PREFIX$1" <&0 &
  fi
  pid=$!
  wait "$pid" || rc=$?
  if [[ -n "$hangup" ]]; then
    kill "$pid" 2>/dev/null || true
    # Detached, so it completes even if this launcher is killed next.
    setsid -f bash -c 'docker stop -t 5 "$1"; [[ -s "$2/ssh-agent.pid" ]] && kill "$(cat "$2/ssh-agent.pid")"; rm -rf -- "$2"' \
      _ "$PREFIX$1" "$(agent_dir "$1")" </dev/null >/dev/null 2>&1
    exit 129
  fi
  trap - HUP TERM
  close_agent "$1"  # closed rather than detached? then its key leaves memory now
  return "$rc"
}

list_sandboxes() {
  local numbered="${1:-}" rows
  rows="$(docker ps -a --filter "label=$LABEL" --format "{{.Label \"$LABEL\"}}\t{{.Label \"opencode-sandbox.keykind\"}}\t{{.Label \"opencode-sandbox.key\"}}\t{{.Status}}\t{{.RunningFor}}\t{{.Label \"opencode-sandbox.source\"}}\t{{.Label \"opencode-sandbox.providers\"}}")"
  if [[ -z "$rows" ]]; then echo "no sandboxes"; return; fi
  sed -E 's/\tUp ([^\t]*)/\topen (\1)/; s/\tExited \([0-9-]+\) /\tclosed /; s/\tCreated\t/\tnew\t/
          s/Less than a second( ago)?/just now/g; s/About an? (minute|hour)/1 \1/g; s/just now ago/just now/g' <<<"$rows" \
    | awk -F'\t' -v n="$numbered" '
        function row(num, a, b, c, d, e, f) { printf "%s%-22s %-13s %-20s %-22s %-15s %s\n", num, a, b, c, d, e, f }
        BEGIN { row(n ? "#   " : "", "NAME", "SSH KEY", "PROVIDER", "STATE", "CREATED", "COPIED FROM") }
        { key = ($2 == "home") ? $3 : $2; sub(/.*\//, "", key)
          prov = ($7 == "") ? "all (old sandbox)" : $7
          row(n ? sprintf("%-3d ", NR) : "", $1, key, prov, $4, $5, $6) }'
}

pick_sandbox() {
  local -a all; local n
  mapfile -t all < <(names)
  (( ${#all[@]} )) || die "no sandboxes yet; create one with: opencode-sandbox -w DIR"
  list_sandboxes numbered >&2
  read -rp "Resume which sandbox? [1-${#all[@]}] " n || die "no choice made"
  [[ "$n" =~ ^[1-9][0-9]*$ ]] && (( n <= ${#all[@]} )) || die "no such choice: $n"
  printf '%s\n' "${all[n-1]}"
}

remove_sandboxes() {
  local -a targets=("$@"); local n reply kind key fp
  (( ${#targets[@]} )) || die "--rm needs sandbox names, or --all"
  if [[ "${targets[0]}" == --all ]]; then
    mapfile -t targets < <(names)
    (( ${#targets[@]} )) || { echo "no sandboxes"; return; }
    read -rp "Delete all ${#targets[@]} sandboxes, their files and disposable keys? [y/N] " reply || reply=""
    [[ "$reply" == [yY]* ]] || { echo "nothing deleted"; return; }
  fi
  for n in "${targets[@]}"; do
    if ! exists "$n"; then note "no sandbox named '$n'"; continue; fi
    kind="$(label "$n" keykind)"; key="$(label "$n" key)"
    docker rm -f -v "$PREFIX$n" >/dev/null
    stop_agent "$(agent_dir "$n")"
    rm -f -- "$(config_file "$n")"
    if [[ "$kind" == disposable ]]; then
      fp="$(fingerprint "$key.pub" 2>/dev/null || true)"
      discard_key "$key"
      echo "removed $n and its disposable key $fp (remove it from any authorized_keys you added it to)"
    else
      echo "removed $n"
    fi
  done
}

abandon_sandbox() {  # undo a half-finished creation
  rm -f -- "$(config_file "$SB_NAME")"
  stop_agent "$(agent_dir "$SB_NAME")"
  [[ -z "${KEY_CREATED:-}" ]] || discard_key "$KEY_PATH"  # only a key we just made
  return 0
}

# --- main --------------------------------------------------------------------

case "${1:-}" in
  -h|--help) usage; exit ;;
  -V|--version)
    echo "opencode-sandbox $VERSION (opencode $(sed -n 's/^ARG OPENCODE_VERSION=//p' "$HERE/Dockerfile"))"
    exit ;;
  --build)  shift; build_image "$@"; exit ;;
  --list)   gc_agents; list_sandboxes; exit ;;
  --rm)     shift; remove_sandboxes "$@"; exit ;;
  --status)
    gc_agents; found=0
    for d in "$RUNDIR"/agents/*/; do
      d="${d%/}"; [[ -S "$d/sock/ssh-agent.sock" ]] || continue
      found=1; echo "sandbox ${d##*/} ($(cat "$d/key" 2>/dev/null)):"
      on_sock "$d/sock/ssh-agent.sock" ssh-add -l 2>&1 | sed 's/^/  /' || true
    done
    (( found )) || echo "no sandbox agents running (they only run while a sandbox is open)"
    exit ;;
  --stop-agent)
    for d in "$RUNDIR"/agents/*/; do [[ -d "$d" ]] && stop_agent "${d%/}"; done
    # the single shared agent used by earlier versions of this launcher
    [[ -s "$RUNDIR/ssh-agent.pid" ]] && kill "$(cat "$RUNDIR/ssh-agent.pid")" 2>/dev/null || true
    rm -rf -- "$RUNDIR/sock" "$RUNDIR/ssh-agent.pid"
    echo "all sandbox ssh-agents stopped"; exit ;;
  --pubkey)
    name="${2:-}"; [[ -n "$name" ]] || die "--pubkey needs a sandbox name (see --list)"
    exists "$name" || die "no sandbox named '$name' (see --list)"
    [[ "$(label "$name" keykind)" != none ]] || die "sandbox '$name' has no SSH key"
    cat "$(label "$name" key).pub"; exit ;;
  --shell)
    name="${2:-}"; [[ -n "$name" ]] || die "--shell needs a sandbox name (see --list)"
    [[ "$(state "$name")" == running ]] \
      || die "sandbox '$name' isn't open; open it first with: opencode-sandbox --resume $name"
    exec docker exec "$TTY" --detach-keys "$DETACH_KEYS" "$PREFIX$name" bash ;;
  --resume)
    name="${2:-}"; [[ -n "$name" ]] || name="$(pick_sandbox)"
    exists "$name" || die "no sandbox named '$name' (see --list)"
    prepare
    [[ "$(label "$name" keykind)" == none ]] || ensure_agent "$name" "$(label "$name" key)"
    if [[ "$(state "$name")" != running ]]; then
      provs="$(label "$name" providers)"
      if [[ -n "$provs" ]]; then write_config "$name" "$provs"
      else note "sandbox '$name' predates provider selection and sees all your providers; recreate it to limit them"; fi
    fi
    v="$(label "$name" version)"
    [[ "$v" == "$VERSION" ]] || note "sandbox '$name' was created by opencode-sandbox ${v:-before 0.1.0} (you have $VERSION) and keeps its original image and settings; create a new sandbox to get the update"
    open_sandbox "$name"; exit ;;
  -*) [[ "$1" == -w || "$1" == -n || "$1" == -k || "$1" == -p || "$1" == -- ]] \
        || die "unknown option: $1 (see: opencode-sandbox --help)" ;;
esac

ws="" name="" keyarg="" provarg=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    -w) [[ $# -ge 2 ]] || die "-w needs a directory"; ws="$2"; shift 2 ;;
    -n) [[ $# -ge 2 ]] || die "-n needs a name"; name="$2"; shift 2 ;;
    -k) [[ $# -ge 2 ]] || die "-k needs a key name, 'new' or 'none'"; keyarg="$2"; shift 2 ;;
    -p) [[ $# -ge 2 ]] || die "-p needs a provider name (or several: a,b)"; provarg="$2"; shift 2 ;;
    -h|--help) usage; exit ;;
    --) shift; break ;;
    *) break ;;
  esac
done

WORKSPACE="$(resolve_workspace "$ws")"
[[ -n "$name" ]] || name="$(default_name "$WORKSPACE")"
[[ "$name" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die "invalid sandbox name: $name"
exists "$name" && die "sandbox '$name' already exists; use: opencode-sandbox --resume $name"
SB_NAME="$name"

choose_key "$keyarg"
choose_providers "$provarg"
prepare
# If creating the sandbox fails, leave nothing of it behind.
trap '[[ -n "${CREATED:-}" ]] || abandon_sandbox' EXIT
write_config "$name" "$PROVIDERS"
[[ "$KEY_KIND" == disposable ]] && new_disposable_key && KEY_CREATED=1
[[ "$KEY_KIND" == none ]] || ensure_agent "$name" "$KEY_PATH"
create_sandbox "$name" "$@"
CREATED=1
[[ "$KEY_KIND" == disposable ]] && show_new_key
open_sandbox "$name"
