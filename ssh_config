# No key from your ~/.ssh ever exists in this container. If the sandbox was
# given a key, the host runs an ssh-agent for it holding only that one key,
# reached via $SSH_AUTH_SOCK; its public half is in ~/.ssh under the key's own
# name, so `ssh -i ~/.ssh/<name> ...` works unchanged and -A forwards only that
# key. Where no host agent is possible, a disposable key is stored here as
# ~/.ssh/sandbox_key instead.
Host *
    IdentityFile ~/.ssh/sandbox_key
    # Seeded host keys live in /etc/ssh/ssh_known_hosts, or in the sandbox's
    # config folder where only folders can be mounted (Apple container); both
    # are read-only. Unknown hosts are learned on first use, changed keys are
    # refused.
    GlobalKnownHostsFile /etc/ssh/ssh_known_hosts /run/opencode-sandbox/config/known_hosts
    StrictHostKeyChecking accept-new
    ServerAliveInterval 30

# With a filtered network the sandbox has no network of its own: ssh leaves
# through the gateway, which lets it reach the hosts on the sandbox's list
# and says which ones aren't (see opencode-sandbox net).
Match exec "test ${OPENCODE_SANDBOX_PROXY:-0} -gt 0"
    ProxyCommand opencode-sandbox-gateway connect %h %p
